rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // An admin is any signed-in user that has a document at admins/{uid}.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Public catalogue: anyone can read, only admins can write.
    match /prices/{priceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin allow-list. Readable by the signed-in user (the panel checks its
    // own membership); never writable from the client — add admins from the
    // Firebase Console.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
